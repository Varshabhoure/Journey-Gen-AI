# Journey Gen AI — example backend configuration
# Copy this file to .env in the project root and supply your OWN values.
# Never commit .env or paste real keys into public files.

# Groq-hosted language model access
GROQ_API_KEY=replace_with_your_groq_api_key

# Optional MCP / research services (needed only if enabled)
TAVILY_API_KEY=replace_with_your_tavily_api_key
OPENWEATHER_API_KEY=replace_with_your_openweather_api_key
AVIATION_STACK_API_KEY=replace_with_your_aviationstack_api_key

# LangGraph PostgreSQL checkpointing
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:replace_with_password@localhost:5432/journey_gen_ai

# JWT authentication: use a long, random secret
JWT_SECRET_KEY=replace_with_a_long_random_secret
